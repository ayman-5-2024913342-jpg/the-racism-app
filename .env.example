# Copy to .env for local development. NEVER commit .env.
APP_ENV=development
# Production requires a random value of 32+ characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-this-before-deployment
# SQLite locally; PostgreSQL in production (postgres:// and postgresql:// URLs are accepted):
DATABASE_URL=sqlite:///./the_great_app.db
# Production: your real domain(s). Comma-separated; wildcards like *.example.com are allowed.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Needed only if a proxy rewrites the Host header:
TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=10
# Unsaved results are deleted after this many hours:
RESULT_TTL_HOURS=24
# Real data appears on /distribution only after this many opt-in contributions:
DISTRIBUTION_MIN_N=50
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_ANALYSES=2
COOKIE_SECURE=false
# Local convenience only; production uses `alembic upgrade head`
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
# Reference normal curve for the 1-100 skin tone score (assumed values, not measured population data):
SCORE_MEAN=50
SCORE_SD=15
